generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String        @id @default(uuid())
  email          String?       @unique
  password       String?
  isGuest        Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  avatarUrl      String?
  displayName    String?
  language       String        @default("en")
  lastSyncStatus String?
  lastSyncedAt   DateTime?
  syncRevision   Int           @default(0)
  assets         Asset[]
  categories     Category[]
  transactions   Transaction[]
  refreshSessions RefreshSession[]
}

model RefreshSession {
  id        String    @id @default(uuid())
  userId    String
  jti       String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Asset {
  id                   String        @id @default(uuid())
  name                 String
  userId               String
  type                 AssetType
  balance              Decimal       @default(0)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  color                String?
  deletedAt            DateTime?
  isArchived           Boolean       @default(false)
  displayOrder         Int           @default(0)
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions         Transaction[] @relation("AssetToTransaction")
  transferTransactions Transaction[] @relation("ToAssetToTransaction")
  @@index([userId])
  @@index([userId, deletedAt])
}

model Category {
  id           String        @id @default(cuid())
  name         String
  userId       String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  color        String?
  icon         String?
  type         CategoryType
  deletedAt    DateTime?
  isSystem     Boolean       @default(false)
  displayOrder Int           @default(0)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@index([userId, deletedAt])
  @@index([userId, type])
}

model Transaction {
  id            String          @id @default(uuid())
  amount        Decimal
  date          DateTime
  userId        String
  assetId       String
  categoryId    String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  note          String?
  type          TransactionType
  deletedAt     DateTime?
  toAssetId     String?
  attachmentUrl String?
  asset         Asset           @relation("AssetToTransaction", fields: [assetId], references: [id], onDelete: Cascade)
  category      Category?       @relation(fields: [categoryId], references: [id])
  toAsset       Asset?          @relation("ToAssetToTransaction", fields: [toAssetId], references: [id])
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([assetId])
  @@index([categoryId])
  @@index([date])
  @@index([userId, date(sort: Desc)])
  @@index([userId, deletedAt])
}

enum AssetType {
  CASH
  BANK
  E_WALLET
  INVESTMENT
  CRYPTO
  OTHER
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  ADJUSTMENT
}
